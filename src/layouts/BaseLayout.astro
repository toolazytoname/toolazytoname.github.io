---
import '../styles/global.css';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import ScrollProgress from '@components/ScrollProgress.astro';
import { SITE, type Seo, websiteJsonLd, articleJsonLd } from '@lib/seo';

interface Props {
  seo?: Seo;
  /** Extra JSON-LD objects to merge into the graph */
  jsonLdExtra?: Record<string, unknown> | Record<string, unknown>[];
  /** Show floating chatbot (home / about / now only) */
  chatbot?: boolean;
}

const { seo, jsonLdExtra, chatbot = false } = Astro.props;
const title = seo?.title ? `${seo.title} · ${SITE.name}` : SITE.name;
const description = seo?.description ?? SITE.description;
const ogImage = new URL(seo?.image ?? '/og-default.png', SITE.url).toString();
const canonical = new URL(Astro.url.pathname, SITE.url).toString();

// JSON-LD: always include WebSite+Person, merge article if applicable
const baseGraph = websiteJsonLd();
let jsonLdOutput: Record<string, unknown>;

if (seo?.type === 'article' && seo.publishedAt) {
  const article = articleJsonLd({
    title: seo.title ?? '',
    description: seo.description,
    url: canonical,
    publishedAt: seo.publishedAt,
    section: seo.section,
    tags: seo.tags,
    image: ogImage,
  });
  jsonLdOutput = {
    '@context': 'https://schema.org',
    '@graph': [...baseGraph['@graph']!, article],
  };
} else {
  jsonLdOutput = baseGraph;
}

// Merge any extras
if (jsonLdExtra) {
  const extras = Array.isArray(jsonLdExtra) ? jsonLdExtra : [jsonLdExtra];
  if (jsonLdOutput['@graph']) {
    (jsonLdOutput['@graph'] as unknown[]).push(...extras);
  }
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- JSON-LD structured data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdOutput)} />

    <!-- Open Graph -->
    <meta property="og:type" content={seo?.type ?? 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Article-specific OG tags -->
    {seo?.type === 'article' && seo.publishedAt && (
      <>
        <meta property="article:published_time" content={seo.publishedAt.toISOString()} />
        <meta property="article:author" content={SITE.author} />
        {seo.section && <meta property="article:section" content={seo.section} />}
        {seo.tags?.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/posts.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} (legacy)`} href="/feed.xml" />

    <meta name="theme-color" content="#0369a1" />

    <!-- Preconnect for photo domain (if added later) -->
    <meta name="robots" content="index,follow" />
  </head>

  <body>
    <a href="#main" class="skip-link">跳到主要内容</a>

    <ScrollProgress />
    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />
    {chatbot && (
      <>
        <div id="chat-host"></div>
        <button type="button" class="chat-fab" data-chat-load aria-label="打开聊天助手">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </button>
        <script>
          import { cacheBustedUrl, moduleUrlFromError } from '../lib/dynamic-import-retry';

          const btn = document.querySelector<HTMLButtonElement>('[data-chat-load]');
          let lastError: unknown;

          async function loadMountChat() {
            const failedUrl = lastError ? moduleUrlFromError(lastError) : null;
            if (failedUrl) {
              return import(/* @vite-ignore */ cacheBustedUrl(failedUrl));
            }
            return import('../components/mount-chat.ts');
          }

          if (btn) {
            btn.addEventListener('click', async () => {
              if (btn.disabled) return;
              if (btn.dataset.chatReload === '1') {
                location.reload();
                return;
              }
              btn.disabled = true;
              btn.setAttribute('aria-busy', 'true');
              try {
                const { mountChat } = await loadMountChat();
                const host = document.getElementById('chat-host');
                if (!host) throw new Error('chat-host missing');
                mountChat(host);
                btn.remove();
              } catch (err) {
                lastError = err;
                console.warn('[chat] failed to load, click to retry', err);
                btn.disabled = false;
                btn.removeAttribute('aria-busy');
                if (moduleUrlFromError(err)) {
                  btn.setAttribute('aria-label', '打开聊天助手（加载失败，点击重试）');
                } else {
                  btn.dataset.chatReload = '1';
                  btn.setAttribute('aria-label', '聊天加载失败，点击刷新页面重试');
                }
              }
            });
          }
        </script>
      </>
    )}

    <noscript>
      <style>
        .reveal {
          opacity: 1;
          transform: none;
        }
        body {
          cursor: auto;
        }
      </style>
    </noscript>

    <script>
      // Reveal-on-scroll — mark in-view items first, then opt into hiding the rest.
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      const markVisible = (el: Element) => el.classList.add('is-visible');

      if (!els.length) {
        // nothing
      } else if (!('IntersectionObserver' in window)) {
        els.forEach(markVisible);
      } else {
        const vh = window.innerHeight || document.documentElement.clientHeight;
        els.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < vh * 0.92 && rect.bottom > 0) markVisible(el);
        });
        document.documentElement.classList.add('reveal-ready');

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                markVisible(e.target);
                io.unobserve(e.target);
              }
            }
          },
          // threshold 0: a tall block whose first pixel crosses the viewport
          // still counts. 0.05 hid article-length elements on short screens.
          { rootMargin: '0px 0px -8% 0px', threshold: 0 },
        );
        els.forEach((el) => {
          if (!el.classList.contains('is-visible')) io.observe(el);
        });
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        top: -40px;
        left: 12px;
        background: var(--color-ink);
        color: var(--color-ivory);
        padding: 8px 12px;
        border-radius: var(--r-md);
        z-index: 10000;
        transition: top 0.2s;
      }
      .skip-link:focus {
        top: 12px;
      }
    </style>
  </body>
</html>
