---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { postSlug } from '@lib/permalink';

export const prerender = true;

const all = (await getCollection('posts')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Collect unique categories
const categoryLabels = new Map<string, string>();
for (const p of all) {
  const cats = Array.isArray(p.data.categories) ? p.data.categories : [p.data.categories];
  cats.forEach((c) => {
    const label = c.toString().trim();
    const key = label.toLowerCase();
    if (key && !categoryLabels.has(key)) categoryLabels.set(key, label);
  });
}
const categories = [...categoryLabels.entries()].sort(([, a], [, b]) => a.localeCompare(b));

// Group posts by year
const byYear = new Map<number, typeof all>();
for (const p of all) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

function slugFor(p: (typeof all)[number]) {
  return postSlug(p.id, p.data);
}

function primaryCat(p: (typeof all)[number]) {
  const cats = Array.isArray(p.data.categories) ? p.data.categories : [p.data.categories];
  return (cats[0] ?? '').toString().trim() || 'uncategorized';
}

function dateStr(p: (typeof all)[number]) {
  return p.data.date.toISOString().slice(0, 10);
}

function monthDay(p: (typeof all)[number]) {
  return `${String(p.data.date.getMonth() + 1).padStart(2, '0')}/${String(p.data.date.getDate()).padStart(2, '0')}`;
}
---

<BaseLayout
  seo={{
    title: 'Posts',
    description: `从 2016 到现在的 ${all.length} 篇文章。`,
  }}
>
  <section class="posts-page">
    <div class="container container-narrow">
      <header class="posts-page__head reveal">
        <h1 class="posts-page__title">{all.length} 篇</h1>
        <p class="posts-page__lede">
          2016 至今的存档。旧文先放着，新的会慢慢写。
        </p>
      </header>

      <!-- Filters -->
      <div class="posts-page__filters reveal">
        <label class="posts-page__search-label" for="post-search">搜索文章</label>
        <input
          type="search"
          class="posts-page__search"
          placeholder="搜索标题…"
          id="post-search"
          data-post-search
        />
        <div class="posts-page__chips" data-post-chips>
          <button class="chip chip--active" data-filter="all">全部</button>
          {categories.map(([key, label]) => (
            <button class="chip" data-filter={key}>{label}</button>
          ))}
        </div>
      </div>

      <!-- Post list grouped by year -->
      <div class="posts-page__list" data-post-list>
        {years.map((year) => (
          <section class="year-section" data-year={year}>
            <h2 class="year-section__title">{year} · {byYear.get(year)!.length} 篇</h2>
            <ol class="year-section__list">
              {byYear.get(year)!.map((p) => (
                <li
                  class="post-item"
                  data-title={p.data.title.toLowerCase()}
                  data-category={primaryCat(p).toLowerCase()}
                  data-tags={(p.data.tags.join(' ') ?? '').toLowerCase()}
                >
                  <a href={`/${slugFor(p)}/`} class="post-item__link">
                    {p.data.cover ? (
                      <img src={p.data.cover} alt="" class="post-item__thumb post-item__thumb--img" loading="lazy" />
                    ) : (
                      <div class="post-item__thumb post-item__thumb--fallback">
                        <span>{monthDay(p)}</span>
                      </div>
                    )}
                    <div class="post-item__body">
                      <div class="post-item__meta">
                        <span class="post-item__cat">{primaryCat(p)}</span>
                        <time class="post-item__date" datetime={dateStr(p)}>{dateStr(p)}</time>
                      </div>
                      <h3 class="post-item__title">{p.data.title}</h3>
                      {p.data.summary && <p class="post-item__summary">{p.data.summary}</p>}
                    </div>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

      <!-- Empty state -->
      <p class="posts-page__empty" data-post-empty hidden>
        没有匹配的文章。
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  function initPostFilters() {
    const search = document.querySelector<HTMLInputElement>('[data-post-search]');
    const chips = document.querySelectorAll<HTMLElement>('[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('.post-item');
    const yearSections = document.querySelectorAll<HTMLElement>('.year-section');
    const empty = document.querySelector<HTMLElement>('[data-post-empty]');

    if (!search || !items.length) return;

    let activeCategory = 'all';

    function apply() {
      const q = search!.value.trim().toLowerCase();
      let visible = 0;

      items.forEach((item) => {
        const title = item.dataset.title ?? '';
        const cat = item.dataset.category ?? '';
        const tags = item.dataset.tags ?? '';
        const matchesSearch = !q || title.includes(q) || tags.includes(q) || cat.includes(q);
        const matchesCat = activeCategory === 'all' || cat === activeCategory;
        const show = matchesSearch && matchesCat;
        item.hidden = !show;
        if (show) visible++;
      });

      // Hide empty year sections
      yearSections.forEach((sec) => {
        const visItems = sec.querySelectorAll<HTMLElement>('.post-item:not([hidden])');
        sec.hidden = visItems.length === 0;
      });

      if (empty) empty.hidden = visible > 0;
    }

    search.addEventListener('input', apply);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeCategory = chip.dataset.filter ?? 'all';
        chips.forEach((c) => c.classList.remove('chip--active'));
        chip.classList.add('chip--active');
        apply();
      });
    });
  }

  document.addEventListener('astro:after-swap', initPostFilters);
  initPostFilters();
</script>

<style>
  .posts-page {
    padding: var(--s-20) 0 var(--s-32);
    min-height: 80vh;
  }

  .posts-page__head {
    margin-bottom: var(--s-8);
  }

  .posts-page__title {
    font-size: clamp(40px, 5vw, 64px);
    margin: var(--s-3) 0 var(--s-4);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .posts-page__lede {
    color: var(--color-text-muted);
    font-size: 17px;
    margin: 0;
  }

  /* Filters */
  .posts-page__filters {
    margin-bottom: var(--s-10);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .posts-page__search {
    width: 100%;
    max-width: 400px;
    font-size: 15px;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--color-border);
    border-radius: var(--r-md);
    background: var(--color-bg);
    color: var(--color-text);
    outline: none;
    transition: border-color var(--t-fast) var(--ease-out);
  }
  .posts-page__search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .posts-page__search::placeholder {
    color: var(--color-text-dim);
  }

  .posts-page__search:focus-visible {
    border-color: var(--color-accent);
  }

  .posts-page__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .chip {
    font-size: 13px;
    padding: 4px 12px;
    border-radius: 980px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--t-fast) var(--ease-out);
  }

  .chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .chip--active {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent);
  }

  .chip--active:hover {
    background: var(--color-accent-dark);
    color: var(--color-accent-contrast);
    border-color: var(--color-accent-dark);
  }

  /* Year sections */
  .year-section {
    margin-bottom: var(--s-10);
  }

  .year-section__title {
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--color-text-dim);
    margin: 0 0 var(--s-4);
  }

  .year-section__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  /* Post items — no borders, separated by spacing + hover background */
  .post-item__link {
    display: flex;
    gap: var(--s-4);
    padding: var(--s-4);
    border-radius: var(--r-lg);
    color: inherit;
    text-decoration: none;
    transition: background var(--t-fast) var(--ease-out);
  }

  .post-item__link:hover {
    background: var(--color-bg-subtle);
  }

  .post-item__link:hover .post-item__title {
    color: var(--color-accent);
  }

  /* Thumbnail */
  .post-item__thumb {
    width: 80px;
    height: 80px;
    border-radius: var(--r-md);
    flex-shrink: 0;
    overflow: hidden;
  }
  .post-item__thumb--img {
    object-fit: cover;
  }
  .post-item__thumb--fallback {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-soft));
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-accent-contrast);
  }

  .post-item__body {
    flex: 1;
    min-width: 0;
  }

  .post-item__meta {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    margin-bottom: var(--s-1);
  }

  .post-item__cat {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 980px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    font-weight: 500;
    background: var(--color-accent-pale);
    color: var(--color-accent-dark);
  }

  .post-item__date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-dim);
  }

  .post-item__title {
    font-size: clamp(18px, 2.2vw, 22px);
    margin: 0 0 var(--s-1);
    color: var(--color-text);
    line-height: 1.25;
    font-weight: 500;
    transition: color var(--t-fast) var(--ease-out);
  }

  .post-item__summary {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Empty state */
  .posts-page__empty {
    text-align: center;
    color: var(--color-text-dim);
    font-size: 16px;
    padding: var(--s-16) 0;
  }

  @media (max-width: 480px) {
    .post-item__thumb { width: 60px; height: 60px; }
  }
</style>
</BaseLayout>
