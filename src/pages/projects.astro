---
// Pre-render at build time → ships as a static asset, served from CDN.
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import { projects, categoryMeta, getFeaturedProjects, type ProjectCategory } from '@data/projects';

const categories: ProjectCategory[] = [
  'mobile-lab',
  'agents',
  'infra',
  'standalone',
  'legacy-ios',
];
const featuredProjects = getFeaturedProjects();
---

<BaseLayout
  seo={{
    title: 'Projects',
    description: `${projects.length} 个开源项目：手机 AI Agent、自动化工具、基础设施、独立产品、老 iOS。`,
  }}
>
  <section class="projects-page">
    <div class="container">
      <header class="projects-page__head reveal">
        <h1 class="projects-page__title">{projects.length} 个开源项目</h1>
        <p class="projects-page__lede">
          从编译器到手机 AI Agent —— 我造的工具，都在这。
        </p>
      </header>

      <section class="projects-featured" aria-labelledby="featured-projects">
        <h2 class="projects-featured__title" id="featured-projects">代表项目</h2>
        <div class="projects-featured__grid">
          {
            featuredProjects.map((project, index) => (
              <ProjectCard project={project} index={index} featured />
            ))
          }
        </div>
      </section>

      {
        categories.map((cat) => {
          const items = projects.filter((p) => p.category === cat);
          const meta = categoryMeta[cat];
          if (items.length === 0) return null;
          return (
            <section class="projects-group">
              <header class="projects-group__head reveal">
                <h2 class="projects-group__title">{meta.label}</h2>
                <p class="projects-group__sub">{meta.sublabel}</p>
              </header>
              <div class="projects-group__list">
                {items.map((p, i) => (
                  <ProjectCard project={p} index={i} />
                ))}
              </div>
            </section>
          );
        })
      }
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page {
    padding: var(--s-16) 0 var(--s-24);
    min-height: 80vh;
  }
  .projects-page__head {
    margin-bottom: var(--s-12);
  }
  .projects-page__title {
    font-size: clamp(36px, 4vw, 54px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0 0 var(--s-4);
  }
  .projects-page__lede {
    color: var(--color-text-muted);
    font-size: 17px;
    line-height: 1.6;
    margin: 0;
  }

  .projects-group {
    margin-bottom: var(--s-8);
  }
  .projects-group:last-child {
    margin-bottom: 0;
  }
  .projects-group__head {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) 1fr;
    align-items: baseline;
    gap: var(--s-5);
    margin-bottom: var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--color-border);
  }
  .projects-group__title {
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .projects-group__sub {
    font-size: 13px;
    color: var(--color-text-dim);
    margin: 0;
  }

  .projects-group__list {
    display: flex;
    flex-direction: column;
  }
  .projects-group__list :global(.proj-card + .proj-card) {
    border-top: 1px solid var(--color-border);
  }

  .projects-featured {
    margin-bottom: var(--s-12);
  }
  .projects-featured__title {
    margin: 0 0 var(--s-4);
    font-size: 18px;
    font-weight: 500;
  }
  .projects-featured__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
  }

  @media (max-width: 760px) {
    .projects-page {
      padding: var(--s-10) 0 var(--s-16);
    }
    .projects-page__head {
      margin-bottom: var(--s-10);
    }
    .projects-group {
      margin-bottom: var(--s-8);
    }
    .projects-featured {
      margin-bottom: var(--s-10);
    }
    .projects-featured__grid {
      grid-template-columns: 1fr;
    }
    .projects-group__head {
      display: block;
    }
    .projects-group__title {
      margin-bottom: var(--s-1);
    }
  }
</style>
