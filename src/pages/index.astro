---
// Pre-render at build time → ships as a static asset, served from CDN.
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import PostFeed from '@components/PostFeed.astro';
---

<BaseLayout>
  <Hero />

  <PostFeed />

  <!-- =========================== Closing CTA =========================== -->
  <section class="closing">
    <div class="container container-narrow closing__inner reveal">
      <p class="eyebrow">Get in touch</p>
      <h2 class="closing__title">想聊点什么？</h2>
      <p class="closing__lede">
        关于合作、技术、户外、或者只是想认识一下 —— 邮件最稳。
      </p>
      <div class="closing__ctas">
        <a href="mailto:lazywc@gmail.com" class="btn btn--primary">lazywc@gmail.com</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Closing */
  .closing {
    padding: var(--s-20) 0 var(--s-16);
    color: var(--color-text);
    text-align: center;
    border-top: 1px solid var(--color-border);
  }
  .closing__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .closing__title {
    font-size: clamp(32px, 4vw, 48px);
    margin: var(--s-3) 0 var(--s-5);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .closing__lede {
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0 0 var(--s-6);
    font-size: 17px;
    line-height: 1.6;
  }
  .closing__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    justify-content: center;
  }
  .closing .btn--primary {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .closing .btn--primary:hover {
    background: var(--color-ink-soft);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--r-md);
    font-size: 15px;
    font-weight: 500;
    transition: transform var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out);
  }
  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }
  .btn--primary {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .btn--primary:hover {
    background: var(--color-ink-soft);
  }
</style>
