---
// Pre-render at build time → ships as a static asset, served from CDN.
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import WorkCard from '@components/WorkCard.astro';
import Timeline from '@components/Timeline.astro';
import PostFeed from '@components/PostFeed.astro';
import { works } from '@data/works';
---

<BaseLayout>
  <Hero />

  <PostFeed />

  <!-- =========================== Works =========================== -->
  <section class="works" id="works">
    <div class="container">
      <header class="section-head reveal">
        <p class="eyebrow">Works · 作品</p>
        <h2 class="section-title">做过的一些东西</h2>
      </header>

      <div class="works__grid">
        {works.map((w, i) => <WorkCard work={w} index={i} />)}
      </div>
    </div>
  </section>

  <!-- =========================== Now =========================== -->
  <section class="now" id="now">
    <div class="container container-narrow">
      <header class="section-head reveal">
        <p class="eyebrow">Now · 当下</p>
        <h2 class="section-title">最近在想、在做</h2>
        <p class="section-sub">
          来自 <a href="/now">/now</a> 页面。每月更新一次。
        </p>
      </header>

      <Timeline />
    </div>
  </section>

  <!-- =========================== Closing CTA =========================== -->
  <section class="closing">
    <div class="container container-narrow closing__inner reveal">
      <p class="eyebrow">Get in touch</p>
      <h2 class="closing__title">想聊点什么？</h2>
      <p class="closing__lede">
        关于合作、技术、户外、或者只是想认识一下 —— 邮件最稳。
      </p>
      <div class="closing__ctas">
        <a href="mailto:lazywc@gmail.com" class="btn btn--primary">lazywc@gmail.com</a>
        <a href="/colophon" class="btn btn--ghost">关于这个站 →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Section headings */
  .section-head {
    margin-bottom: var(--s-10);
    max-width: 720px;
  }
  .section-title {
    font-size: clamp(28px, 3.5vw, 40px);
    line-height: 1.15;
    margin: var(--s-3) 0;
    color: var(--color-text);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .section-sub {
    color: var(--color-text-muted);
    font-size: 17px;
    line-height: 1.6;
    margin: 0;
  }

  /* Works */
  .works {
    padding: var(--s-24) 0;
    border-top: 1px solid var(--color-border);
  }
  .works__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-5);
    max-width: 720px;
  }

  /* Now */
  .now {
    padding: var(--s-24) 0;
    border-top: 1px solid var(--color-border);
  }

  /* Closing */
  .closing {
    padding: var(--s-20) 0 var(--s-16);
    color: var(--color-text);
    text-align: center;
    border-top: 1px solid var(--color-border);
  }
  .closing__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .closing__title {
    font-size: clamp(32px, 4vw, 48px);
    margin: var(--s-3) 0 var(--s-5);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  .closing__lede {
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0 0 var(--s-6);
    font-size: 17px;
    line-height: 1.6;
  }
  .closing__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    justify-content: center;
  }
  .closing .btn--primary {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .closing .btn--primary:hover {
    background: var(--color-ink-soft);
  }
  .closing .btn--ghost {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .closing .btn--ghost:hover {
    background: var(--color-bg-subtle);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--r-md);
    font-size: 15px;
    font-weight: 500;
    transition: transform var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out);
  }
  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }
  .btn--primary {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .btn--primary:hover {
    background: var(--color-ink-soft);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .btn--ghost:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-subtle);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .works__grid { grid-template-columns: 1fr; }
  }
</style>
