---
export const prerender = true;

import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  seo={{
    title: '404',
    description: '页面没找到。',
  }}
>
  <section class="not-found">
    <div class="container container-narrow">
      <div class="not-found__inner reveal">
        <p class="not-found__code">404</p>
        <h1 class="not-found__title">这条路径不存在</h1>
        <p class="not-found__lede">
          链接可能写错了，或者页面已经搬走。回主页看看项目，或者翻翻文章。
        </p>
        <div class="not-found__ctas">
          <a href="/" class="btn btn--primary">回到主页</a>
          <a href="/projects/" class="btn btn--ghost">看项目</a>
          <a href="/posts/" class="btn btn--ghost">浏览文章</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 80vh;
    display: grid;
    place-items: center;
    padding: var(--s-20) 0;
  }
  .not-found__inner {
    text-align: center;
  }
  .not-found__code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--color-accent);
  }
  .not-found__title {
    font-size: clamp(36px, 6vw, 56px);
    margin: var(--s-4) 0 var(--s-5);
    color: var(--color-text);
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .not-found__lede {
    color: var(--color-text-muted);
    max-width: 420px;
    margin: 0 auto var(--s-8);
    font-size: 17px;
    line-height: 1.6;
  }
  .not-found__ctas {
    display: flex;
    gap: var(--s-3);
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border-radius: var(--r-md);
    font-size: 15px;
    font-weight: 500;
    transition:
      transform var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out);
  }
  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }
  .btn--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .btn--primary:hover {
    background: var(--color-accent-dark);
  }
  .btn--ghost {
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }
  .btn--ghost:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-pale);
  }
</style>
