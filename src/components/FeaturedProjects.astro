---
import { projects, getHomeFeaturedProjects } from '@data/projects';
import WechatQr from '@components/WechatQr.astro';

const featured = getHomeFeaturedProjects();
---

<section class="home-projects" aria-labelledby="home-projects-title">
  <div class="container container-narrow">
    <header class="home-projects__head reveal">
      <h2 class="home-projects__title" id="home-projects-title">在做的事</h2>
      <p class="home-projects__lede">已经上线、打开就能用的几件产品。</p>
    </header>

    <ul class="home-projects__list">
      {
        featured.map((project, i) => {
          const productImage =
            project.image && project.image !== project.wechat?.qr ? project.image : undefined;
          return (
          <li class="home-projects__item reveal" style={`--i: ${i};`}>
            <article
              class:list={[
                'home-projects__card',
                !productImage && 'home-projects__card--text',
                project.wechat && 'home-projects__card--qr',
              ]}
            >
              <a
                href={project.demo ?? project.repo}
                class="home-projects__link"
                target="_blank"
                rel="noopener"
              >
                {productImage && (
                  productImage.endsWith('.png') ? (
                    <picture>
                      <source type="image/webp" srcset={productImage.replace(/\.png$/, '.webp')} />
                      <img
                        src={productImage}
                        alt=""
                        class="home-projects__img"
                        loading={i === 0 ? 'eager' : 'lazy'}
                        width="640"
                        height="360"
                      />
                    </picture>
                  ) : (
                    <img
                      src={productImage}
                      alt=""
                      class="home-projects__img"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      width="640"
                      height="360"
                    />
                  )
                )}
                <div class="home-projects__body">
                  <div class="home-projects__meta">
                    <h3 class="home-projects__name">{project.title}</h3>
                    <span class={`home-projects__status home-projects__status--${project.status}`}>
                      {project.status === 'shipped' ? '已上线' : '进行中'}
                    </span>
                  </div>
                  <p class="home-projects__summary">
                    {project.caseStudy?.contribution ?? project.summary ?? project.description}
                  </p>
                </div>
              </a>
              {project.wechat && (
                <WechatQr src={project.wechat.qr} name={project.wechat.name} variant="tile" />
              )}
            </article>
          </li>
          );
        })
      }
    </ul>

    <div class="home-projects__more reveal">
      <a href="/projects/" class="home-projects__more-link">
        全部 {projects.length} 个项目 →
      </a>
    </div>
  </div>
</section>

<style>
  .home-projects {
    padding: var(--s-16) 0 var(--s-8);
  }
  .home-projects__head {
    margin-bottom: var(--s-8);
  }
  .home-projects__title {
    margin: 0 0 var(--s-3);
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .home-projects__lede {
    margin: 0;
    font-size: 17px;
    color: var(--color-text-muted);
  }
  .home-projects__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .home-projects__card {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    gap: var(--s-4);
    padding: var(--s-4);
    border: 1px solid var(--color-border);
    border-radius: var(--r-lg);
    background: var(--color-bg);
    transition:
      border-color var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out);
  }
  .home-projects__card--qr {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .home-projects__link {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--s-5);
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }
  .home-projects__link:has(.home-projects__img--qr) {
    grid-template-columns: 104px 1fr;
  }
  .home-projects__card--text .home-projects__link {
    grid-template-columns: 1fr;
  }
  .home-projects__card:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-soft);
  }
  .home-projects__img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: var(--r-md);
    background: var(--color-bg-subtle);
  }
  .home-projects__img--qr {
    height: 104px;
    object-fit: contain;
    background: #fff;
  }
  .home-projects__body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--s-2);
  }
  .home-projects__meta {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .home-projects__name {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    color: var(--color-text);
  }
  .home-projects__card:hover .home-projects__name {
    color: var(--color-accent);
  }
  .home-projects__card :global(.wx-qr--tile) {
    align-self: center;
    padding-right: 4px;
  }
  .home-projects__status {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 2px 8px;
    border-radius: var(--r-sm);
  }
  .home-projects__status--shipped {
    background: var(--color-accent-pale);
    color: var(--color-accent-dark);
  }
  .home-projects__status--wip {
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
  }
  .home-projects__summary {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .home-projects__case {
    margin: var(--s-2) 0 0;
    display: grid;
    gap: 6px;
  }
  .home-projects__case div {
    display: grid;
    grid-template-columns: 4.5em 1fr;
    gap: var(--s-2);
    font-size: 13px;
    line-height: 1.5;
  }
  .home-projects__case dt {
    margin: 0;
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .home-projects__case dd {
    margin: 0;
    color: var(--color-text);
  }
  .home-projects__more {
    margin-top: var(--s-6);
    text-align: center;
  }
  .home-projects__more-link {
    font-size: 15px;
    color: var(--color-text-muted);
  }
  .home-projects__more-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 600px) {
    .home-projects__card,
    .home-projects__card--qr {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    .home-projects__link,
    .home-projects__link:has(.home-projects__img--qr) {
      grid-template-columns: 1fr;
    }
    .home-projects__img {
      height: 200px;
    }
    .home-projects__img--qr {
      width: 104px;
      height: 104px;
    }
    .home-projects__card :global(.wx-qr--tile) {
      align-self: flex-start;
    }
  }
</style>
