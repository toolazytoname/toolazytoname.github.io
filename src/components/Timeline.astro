---
import { nowEntries } from '@data/now';

const sorted = [...nowEntries].sort((a, b) => a.date.localeCompare(b.date));

const tagLabel: Record<string, string> = {
  work: '工作',
  life: '生活',
  travel: '出行',
  'open-source': '开源',
};
---

<ol class="timeline" reversed>
  {
    sorted.map((entry, i) => (
      <li class="timeline__item reveal" style={`--i: ${i};`}>
        <div class="timeline__dot" aria-hidden="true" />
        <div class="timeline__content">
          <p class="timeline__date">{entry.date}</p>
          <h3 class="timeline__title">{entry.title}</h3>
          <p class="timeline__body">{entry.body}</p>
          {entry.tag && (
            <span class={`timeline__tag timeline__tag--${entry.tag}`}>
              {tagLabel[entry.tag] ?? entry.tag}
            </span>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--color-border);
  }
  .timeline__item {
    position: relative;
    padding-left: var(--s-10);
    padding-bottom: var(--s-8);
    transition-delay: calc(var(--i, 0) * 80ms);
  }
  .timeline__item:last-child {
    padding-bottom: 0;
  }
  .timeline__dot {
    position: absolute;
    left: 6px;
    top: 8px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-bg-pale);
  }
  .timeline__content {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--r-lg);
    padding: var(--s-5) var(--s-6);
  }
  .timeline__date {
    margin: 0 0 var(--s-2);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-dim);
  }
  .timeline__title {
    font-size: 20px;
    font-weight: 500;
    margin: 0 0 var(--s-3);
    color: var(--color-text);
    letter-spacing: -0.01em;
  }
  .timeline__body {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.65;
    font-size: 15px;
  }
  .timeline__tag {
    display: inline-block;
    margin-top: var(--s-3);
    font-size: 11px;
    padding: 2px 10px;
    border-radius: var(--r-sm);
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
  }
  .timeline__tag--work {
    background: var(--color-accent-pale);
    color: var(--color-accent-dark);
  }
  .timeline__tag--life {
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
  }
  .timeline__tag--travel {
    background: var(--color-accent-pale);
    color: var(--color-accent-dark);
  }
  .timeline__tag--open-source {
    background: var(--color-bg-muted);
    color: var(--color-text);
  }
</style>
