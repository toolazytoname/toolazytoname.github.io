---
import { Moon, Sun } from '@lucide/astro';

const links = [
  { href: '/', label: '首页' },
  { href: '/projects/', label: '项目' },
  { href: '/posts/', label: '文章' },
  { href: '/now/', label: '近况' },
  { href: '/about/', label: '关于' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="nav" data-nav>
  <div class="nav__inner container-wide">
    <a href="/" class="nav__brand" aria-label="首页">
      <span class="nav__brand-mark">lazy</span>
      <span class="nav__brand-en">weichao.ren</span>
    </a>

    <nav class="nav__links" aria-label="主导航">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['nav__link', { 'is-active': isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <button type="button" class="nav__theme" data-theme-toggle aria-label="夜间模式" aria-pressed="false" title="切换到夜间模式">
        <Moon class="nav__moon" size={20} stroke-width={1.75} aria-hidden="true" />
        <Sun class="nav__sun" size={20} stroke-width={1.75} aria-hidden="true" />
        <span class="nav__theme-tip" data-theme-label aria-hidden="true">切换到夜间模式</span>
      </button>
      <button
        type="button"
        class="nav__toggle"
        aria-label="打开菜单"
        aria-expanded="false"
        data-nav-toggle
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav__mobile" data-nav-mobile hidden>
    {
      links.map((l) => (
        <a
          href={l.href}
          class:list={['nav__mobile-link', { 'is-active': isActive(l.href) }]}
        >
          {l.label}
        </a>
      ))
    }
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--color-nav-bg);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--color-border);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .nav__brand {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    color: var(--color-text);
    font-weight: 500;
  }
  .nav__brand:hover {
    text-decoration: none;
  }
  .nav__brand-mark {
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .nav__brand-en {
    font-size: 13px;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
  }
  .nav__links {
    display: flex;
    gap: var(--s-5);
    margin-left: auto;
    margin-right: var(--s-5);
  }
  .nav__link {
    color: var(--color-text-muted);
    font-size: 14px;
    padding: 6px 2px;
    transition: color var(--t-fast) var(--ease-out);
    position: relative;
  }
  .nav__link:hover {
    color: var(--color-text);
    text-decoration: none;
  }
  .nav__link.is-active {
    color: var(--color-text);
  }
  .nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--s-1);
  }
  .nav__theme {
    display: none;
    position: relative;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    border-radius: var(--r-md);
    color: var(--color-text-muted);
  }
  :global(.theme-ready) .nav__theme { display: grid; }
  .nav__theme:hover { background: var(--color-bg-muted); color: var(--color-text); }
  .nav__theme :global(.nav__sun) { display: none; }
  :global([data-theme='dark']) .nav__theme :global(.nav__moon) { display: none; }
  :global([data-theme='dark']) .nav__theme :global(.nav__sun) { display: block; }
  .nav__theme-tip {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    padding: 6px 10px;
    border: 1px solid var(--color-border);
    border-radius: var(--r-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 12px;
    white-space: nowrap;
    pointer-events: none;
    visibility: hidden;
  }
  .nav__theme:focus-visible .nav__theme-tip { visibility: visible; }
  @media (hover: hover) {
    .nav__theme:hover .nav__theme-tip { visibility: visible; }
  }

  .nav__toggle {
    display: none;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .nav__toggle span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 200ms var(--ease-out), opacity 200ms;
    transform-origin: center;
  }
  .nav__toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] span:nth-child(2) {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .nav__mobile {
    display: none;
    flex-direction: column;
    padding: var(--s-3) var(--s-6) var(--s-5);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .nav__mobile:not([hidden]) {
    display: flex;
  }
  .nav__mobile-link {
    padding: var(--s-3) 0;
    color: var(--color-text);
    font-size: 17px;
    border-bottom: 1px solid var(--color-border);
  }
  .nav__mobile-link.is-active {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .nav__links {
      display: none;
    }
    .nav__toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const mobile = document.querySelector<HTMLElement>('[data-nav-mobile]');

  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', '打开菜单');
    if (mobile) mobile.hidden = true;
  }

  if (toggle && mobile) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? '打开菜单' : '关闭菜单');
      mobile.hidden = open;
    });
  }

  mobile?.querySelectorAll('a').forEach((a: HTMLAnchorElement) =>
    a.addEventListener('click', closeMenu),
  );

  window.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'Escape') return;
    if (toggle?.getAttribute('aria-expanded') !== 'true') return;
    closeMenu();
    toggle?.focus();
  });
</script>
