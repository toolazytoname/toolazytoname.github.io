---
import { createHash } from 'node:crypto';
import themeScript from '../lib/theme-init.js?raw';
// is:inline is intentionally unprocessed by Astro. Register its exact bytes so
// the pre-paint theme initializer remains usable under the hashed script CSP.
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(themeScript).digest('base64')}`);
---
<script is:inline set:html={themeScript} />
