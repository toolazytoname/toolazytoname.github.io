---
import Icon from '@components/Icons.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <p class="footer__brand serif">lazy</p>
        <p class="footer__tag">weichao.ren</p>
      </div>

      <nav class="footer__col" aria-label="站点">
        <p class="footer__heading">站点</p>
        <a href="/">主页</a>
        <a href="/posts/">文章</a>
        <a href="/projects/">项目</a>
        <a href="/about/">关于</a>
      </nav>

      <nav class="footer__col" aria-label="外部链接">
        <p class="footer__heading">外部</p>
        <a href="https://github.com/toolazytoname" rel="noopener" target="_blank">
          <Icon name="github" size={15} /> GitHub
        </a>
        <a href="/posts.xml">
          <Icon name="rss" size={15} /> RSS
        </a>
        <a href="mailto:lazywc@gmail.com">
          <Icon name="mail" size={15} /> Email
        </a>
      </nav>

      <div class="footer__col">
        <p class="footer__heading">订阅</p>
        <p class="footer__copy">每月一封 email，写一点最近在想的事。</p>
        <a href="/posts.xml" class="footer__btn">RSS →</a>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} lazy. Built on Astro + Vercel.</p>
      <p class="footer__build">Last build: <time datetime={new Date().toISOString()}>just now</time></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-dark-bg);
    color: var(--color-dark-text);
    padding: var(--s-16) 0 var(--s-6);
    margin-top: var(--s-10);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 2fr;
    gap: var(--s-10);
    padding-bottom: var(--s-12);
  }
  .footer__brand {
    font-size: 24px;
    margin: 0 0 var(--s-2);
    color: var(--color-dark-text);
  }
  .footer__tag {
    color: var(--color-dark-text-dim);
    margin: 0;
    font-size: 14px;
  }
  .footer__heading {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-dark-text-dim);
    margin: 0 0 var(--s-4);
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }
  .footer__col a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-dark-text-muted);
    font-size: 14px;
    transition: color var(--t-fast);
  }
  .footer__col a:hover {
    color: var(--color-dark-text);
    text-decoration: none;
  }
  .footer__copy {
    color: var(--color-dark-text-dim);
    font-size: 13px;
    line-height: 1.5;
    margin: 0 0 var(--s-3);
  }
  .footer__btn {
    align-self: flex-start;
    background: var(--color-dark-bg-soft);
    color: var(--color-dark-text);
    padding: 8px 14px;
    border-radius: 980px;
    font-size: 13px;
    transition: background var(--t-fast) var(--ease-out);
  }
  .footer__btn:hover {
    background: var(--color-dark-border);
    text-decoration: none;
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    padding-top: var(--s-6);
    color: var(--color-dark-text-dim);
    font-size: 12px;
  }
  .footer__bottom p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
    }
    .footer__bottom {
      flex-direction: column;
      gap: var(--s-2);
    }
  }
  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
