---
import type { Project } from '@data/projects';

const LANG_COLORS: Record<string, string> = {
  Go: '#00ADD8',
  Python: '#3776AB',
  Shell: '#4EAA25',
  'Objective-C': '#438EFF',
  Java: '#b07219',
  HTML: '#e34c26',
  TypeScript: '#3178C6',
  JavaScript: '#f1e05a',
};

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const dotColor = project.language ? LANG_COLORS[project.language] : null;
---

<article class="proj-card reveal" style={`--i: ${index};`}>
  {project.image && (
    <a href={project.repo} class="proj-card__image-link" target="_blank" rel="noopener">
      <img
        src={project.image}
        alt=""
        class="proj-card__image"
        loading="lazy"
        decoding="async"
      />
    </a>
  )}

  <div class="proj-card__body">
    <div class="proj-card__head">
      <span class="proj-card__title-row">
        {project.language && (
          <span
            class="proj-card__dot"
            style={dotColor ? `background:${dotColor};` : ''}
            title={project.language}
            aria-hidden="true"
          ></span>
        )}
        <span class="proj-card__name">{project.title}</span>
      </span>
      <span class="proj-card__meta">
        <span class={`proj-card__status proj-card__status--${project.status}`}>
          {project.status}
        </span>
        {project.stars > 0 && (
          <span class="proj-card__stars">★ {project.stars}</span>
        )}
      </span>
    </div>

    <p class="proj-card__desc">{project.description}</p>

    <div class="proj-card__footer">
      {project.language && <span class="proj-card__lang">{project.language}</span>}
      <span class="proj-card__links">
        {project.demo && (
          <a href={project.demo} class="proj-card__action" target="_blank" rel="noopener">主站 →</a>
        )}
        <a href={project.repo} class="proj-card__action proj-card__action--repo" target="_blank" rel="noopener">GitHub →</a>
      </span>
    </div>
  </div>
</article>

<style>
  .proj-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: stretch;
    min-height: 126px;
    border-radius: var(--r-md);
    background: var(--color-bg);
    overflow: hidden;
    border: 1px solid transparent;
    transition: border-color var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out);
  }
  .proj-card:hover {
    border-color: var(--color-border);
    background: var(--color-bg-soft);
  }

  .proj-card__image-link {
    display: block;
    width: 148px;
    min-height: 100%;
    text-decoration: none;
    overflow: hidden;
    background: var(--color-dark-bg);
  }
  .proj-card__image {
    width: 100%;
    height: 100%;
    min-height: 126px;
    object-fit: cover;
    transition: transform var(--t-slow) var(--ease-out);
  }
  .proj-card:hover .proj-card__image {
    transform: scale(1.04);
  }

  .proj-card__meta {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-shrink: 0;
  }

  .proj-card__status {
    font-size: 10px;
    padding: 3px 8px;
    border-radius: var(--r-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .proj-card__status--shipped {
    background: var(--color-accent-pale);
    color: var(--color-accent-dark);
  }
  .proj-card__status--wip {
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
  }

  .proj-card__body {
    min-width: 0;
    padding: var(--s-3) var(--s-4);
    display: flex;
    flex-direction: column;
  }

  .proj-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    margin-bottom: var(--s-1);
  }
  .proj-card__title-row {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
  }
  .proj-card__dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--color-text-dim);
  }
  .proj-card__name {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--t-fast) var(--ease-out);
  }
  .proj-card:hover .proj-card__name {
    color: var(--color-accent);
  }
  .proj-card__stars {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-dim);
    flex-shrink: 0;
  }

  .proj-card__desc {
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-text-muted);
    margin: 0 0 auto;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .proj-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    padding-top: var(--s-2);
  }
  .proj-card__lang {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-dim);
  }
  .proj-card__links {
    display: flex;
    gap: var(--s-3);
  }
  .proj-card__action {
    display: inline-flex;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }
  .proj-card__action:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .proj-card__action--repo {
    color: var(--color-text-dim);
  }

  @media (max-width: 760px) {
    .proj-card {
      min-height: 112px;
    }
    .proj-card__image-link {
      width: 104px;
    }
    .proj-card__image {
      min-height: 112px;
    }
    .proj-card__body {
      padding: var(--s-3);
    }
    .proj-card__status {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .proj-card__image-link {
      width: 88px;
    }
    .proj-card__name {
      font-size: 15px;
    }
    .proj-card__desc {
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
  }
</style>
