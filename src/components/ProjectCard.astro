---
import type { Project } from '@data/projects';
import WechatQr from '@components/WechatQr.astro';

const LANG_COLORS: Record<string, string> = {
  Go: '#00ADD8',
  Python: '#3776AB',
  Shell: '#4EAA25',
  'Objective-C': '#438EFF',
  Java: '#b07219',
  HTML: '#e34c26',
  TypeScript: '#3178C6',
  JavaScript: '#f1e05a',
  Rust: '#dea584',
};

interface Props {
  project: Project;
  index: number;
  featured?: boolean;
  comingSoon?: boolean;
}

const { project, index, featured = false, comingSoon = false } = Astro.props;
const showPanel = featured || comingSoon;
const dotColor = project.language ? LANG_COLORS[project.language] : null;
const blurb = project.summary ?? project.description;
---

<article
  class:list={[
    'proj-card',
    showPanel && 'proj-card--featured',
    comingSoon && 'proj-card--soon',
    'reveal',
  ]}
  style={`--i: ${index};`}
>
  {
    showPanel && project.image && (
      <a
        href={project.demo ?? project.repo}
        class="proj-card__media"
        target="_blank"
        rel="noopener"
        tabindex="-1"
        aria-hidden="true"
      >
        <img src={project.image} alt="" loading="lazy" width="640" height="360" />
      </a>
    )
  }

  <div class="proj-card__main">
    <div class="proj-card__title-row">
      {
        project.language && (
          <span
            class="proj-card__dot"
            style={dotColor ? `background:${dotColor};` : ''}
            title={project.language}
            aria-hidden="true"
          />
        )
      }
      <h3 class="proj-card__name">{project.title}</h3>
      {
        project.stars > 0 && (
          <span class="proj-card__stars">★ {project.stars}</span>
        )
      }
    </div>

    {showPanel && <p class="proj-card__desc">{blurb}</p>}
  </div>

  <div class="proj-card__aside">
    {
      showPanel && (
        <span
          class={`proj-card__status proj-card__status--${comingSoon ? 'soon' : project.status}`}
        >
          {comingSoon ? '敬请期待' : project.status === 'shipped' ? '已上线' : '进行中'}
        </span>
      )
    }
    {project.language && <span class="proj-card__lang">{project.language}</span>}
    {
      featured && !comingSoon && project.wechat && (
        <WechatQr src={project.wechat.qr} name={project.wechat.name} variant="tile" />
      )
    }
    <span class="proj-card__links">
      {
        project.demo && (
          <a href={project.demo} class="proj-card__action" target="_blank" rel="noopener">
            {comingSoon ? '预览' : '主站'}
          </a>
        )
      }
      {
        !showPanel && project.wechat && (
          <WechatQr src={project.wechat.qr} name={project.wechat.name} variant="compact" />
        )
      }
      <a
        href={project.repo}
        class="proj-card__action proj-card__action--repo"
        target="_blank"
        rel="noopener"
        aria-label={`${project.title} GitHub`}
      >
        GitHub ↗
      </a>
    </span>
  </div>
</article>

<style>
  .proj-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-4);
    min-height: 54px;
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-md);
    transition: background var(--t-fast) var(--ease-out);
  }
  .proj-card:hover {
    background: var(--color-bg-soft);
  }
  .proj-card--featured {
    grid-template-columns: 140px minmax(0, 1fr) auto;
    align-items: start;
    min-height: 0;
    padding: var(--s-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }
  .proj-card--featured:not(:has(.proj-card__media)) {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .proj-card--featured:hover {
    border-color: var(--color-accent);
  }
  .proj-card__media {
    display: block;
    width: 140px;
    height: 88px;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--color-bg-subtle);
    align-self: start;
  }
  .proj-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .proj-card__main {
    min-width: 0;
  }
  .proj-card__title-row {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
  }
  .proj-card__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex: 0 0 auto;
    background: var(--color-text-dim);
  }
  .proj-card__name {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: var(--color-text);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--t-fast) var(--ease-out);
  }
  .proj-card--featured .proj-card__name {
    font-size: 17px;
    white-space: normal;
  }
  .proj-card:hover .proj-card__name {
    color: var(--color-accent);
  }
  .proj-card__stars,
  .proj-card__lang {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-dim);
  }
  .proj-card__desc {
    max-width: 46ch;
    margin: var(--s-2) 0 0;
    color: var(--color-text-muted);
    font-size: 14px;
    line-height: 1.55;
  }
  .proj-card__aside {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--s-3);
  }
  .proj-card--featured .proj-card__aside {
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-2);
  }
  .proj-card--featured .proj-card__aside :global(.wx-qr--tile) {
    margin-block: var(--s-1);
  }
  .proj-card__status {
    padding: 3px 8px;
    border-radius: var(--r-sm);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.4px;
  }
  .proj-card__status--shipped {
    background: var(--color-accent-pale);
    color: var(--color-accent-dark);
  }
  .proj-card__status--wip,
  .proj-card__status--soon {
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
  }
  .proj-card--soon {
    border-style: dashed;
  }
  .proj-card__links {
    display: flex;
    gap: var(--s-3);
  }
  .proj-card__action {
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .proj-card__action:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .proj-card__action--repo {
    color: var(--color-text-dim);
  }

  @media (max-width: 720px) {
    .proj-card--featured {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    .proj-card__media {
      width: 100%;
      height: 140px;
    }
    .proj-card--featured .proj-card__aside {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      flex-wrap: wrap;
    }
    .proj-card--featured .proj-card__aside :global(.wx-qr--tile) {
      order: 10;
      width: 100%;
      align-items: flex-start;
      margin: var(--s-2) 0 0;
    }
  }

  @media (max-width: 620px) {
    .proj-card {
      gap: var(--s-2);
      padding-inline: 0;
    }
    .proj-card--featured {
      padding: var(--s-4);
    }
    .proj-card__lang {
      display: none;
    }
    .proj-card__desc {
      font-size: 13px;
    }
  }
</style>
