---
import type { Project } from '@data/projects';

const LANG_COLORS: Record<string, string> = {
  Go: '#00ADD8',
  Python: '#3776AB',
  Shell: '#4EAA25',
  'Objective-C': '#438EFF',
  Java: '#b07219',
  HTML: '#e34c26',
  TypeScript: '#3178C6',
  JavaScript: '#f1e05a',
};

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const dotColor = project.language ? LANG_COLORS[project.language] : null;
---

<article class="proj-card reveal" style={`--i: ${index};`}>
  {project.image && (
    <a href={project.repo} class="proj-card__image-link" target="_blank" rel="noopener">
      <div class="proj-card__image-wrap">
        <img
          src={project.image}
          alt={project.title}
          class="proj-card__image"
          loading="lazy"
          decoding="async"
        />
        <span class={`proj-card__status proj-card__status--${project.status}`}>
          {project.status}
        </span>
      </div>
    </a>
  )}

  <div class="proj-card__body">
    <div class="proj-card__head">
      <span class="proj-card__title-row">
        {project.language && (
          <span
            class="proj-card__dot"
            style={dotColor ? `background:${dotColor};` : ''}
            title={project.language}
            aria-hidden="true"
          ></span>
        )}
        <span class="proj-card__name">{project.title}</span>
      </span>
      <span class="proj-card__meta">
        {!project.image && (
          <span class={`proj-card__status proj-card__status--${project.status}`}>
            {project.status}
          </span>
        )}
        {project.stars > 0 && (
          <span class="proj-card__stars">★ {project.stars}</span>
        )}
      </span>
    </div>

    <p class="proj-card__desc">{project.description}</p>

    <div class="proj-card__footer">
      {project.language && <span class="proj-card__lang">{project.language}</span>}
      <span class="proj-card__links">
        {project.demo && (
          <a href={project.demo} class="proj-card__action" target="_blank" rel="noopener">主站 →</a>
        )}
        <a href={project.repo} class="proj-card__action proj-card__action--repo" target="_blank" rel="noopener">GitHub →</a>
      </span>
    </div>
  </div>
</article>

<style>
  .proj-card {
    border-radius: var(--r-lg);
    background: var(--color-bg);
    overflow: hidden;
    transition: transform var(--t-fast) var(--ease-out),
      box-shadow var(--t-fast) var(--ease-out);
  }
  .proj-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(14, 165, 233, 0.1);
  }

  .proj-card__image-link {
    display: block;
    text-decoration: none;
  }

  /* Image — top, fixed aspect ratio (16:10), always uniform */
  .proj-card__image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-dark-bg);
    flex-shrink: 0;
  }
  .proj-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--t-slow) var(--ease-out);
  }
  .proj-card:hover .proj-card__image {
    transform: scale(1.04);
  }

  .proj-card__meta {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-shrink: 0;
  }

  /* Status badge on image, and a compact in-body version when no image exists. */
  .proj-card__status {
    font-size: 10px;
    padding: 3px 8px;
    border-radius: var(--r-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }
  .proj-card__image-wrap .proj-card__status {
    position: absolute;
    top: 10px;
    right: 10px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .proj-card__status--shipped {
    background: rgba(14, 165, 233, 0.85);
    color: #fff;
  }
  .proj-card__status--wip {
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
  }
  .proj-card__status--archived {
    background: rgba(0, 0, 0, 0.4);
    color: rgba(255, 255, 255, 0.8);
  }

  /* Body — below image */
  .proj-card__body {
    padding: var(--s-4) var(--s-5) var(--s-3);
    display: flex;
    flex-direction: column;
  }

  .proj-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    margin-bottom: var(--s-2);
  }
  .proj-card__title-row {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
  }
  .proj-card__dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
    background: var(--color-text-dim);
  }
  .proj-card__name {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color var(--t-fast) var(--ease-out);
  }
  .proj-card:hover .proj-card__name {
    color: var(--color-accent);
  }
  .proj-card__stars {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-dim);
    flex-shrink: 0;
  }

  .proj-card__desc {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0 0 var(--s-3);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .proj-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px solid var(--color-border);
  }
  .proj-card__lang {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-text-dim);
  }
  .proj-card__links {
    display: flex;
    gap: var(--s-3);
  }
  .proj-card__action {
    display: inline-flex;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
  }
  .proj-card__action:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .proj-card__action--repo {
    color: var(--color-text-dim);
  }
</style>
