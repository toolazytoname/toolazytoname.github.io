---
---

<section class="hero" id="hero">
  <div class="container container-narrow hero__inner">
    <h1 class="hero__sr-only">lazy，独立开发者</h1>

    <div class="hero__terminal">
      <div class="terminal__bar">
        <span class="terminal__dot"></span>
        <span class="terminal__dot"></span>
        <span class="terminal__dot"></span>
        <span class="terminal__title">whoami.sh</span>
      </div>
      <pre class="terminal__body"><code><span class="terminal__prompt">$</span> whoami
<span class="terminal__out">ex-big-tech / indie-dev</span>

<span class="terminal__prompt">$</span> ls skills/
<span class="terminal__out">swift/  llvm/  typescript/  ai/</span>

<span class="terminal__prompt">$</span> cat status.txt
<span class="terminal__out">building tools with AI</span>
<span class="terminal__out">skiing · climbing · diving</span></code></pre>
    </div>

    <div class="hero__ctas">
      <a href="#posts" class="btn btn--primary">读文章</a>
      <a href="/projects/" class="btn btn--ghost">看项目</a>
      <a href="/about/" class="btn btn--ghost">关于我</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--s-16) 0 var(--s-12);
  }

  .hero__inner {
    max-width: 680px;
  }

  .hero__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Terminal code block */
  .hero__terminal {
    background: var(--color-dark-bg);
    border-radius: var(--r-lg);
    overflow: hidden;
    margin-bottom: var(--s-6);
    border: 1px solid var(--color-dark-border);
  }
  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--color-dark-bg-soft);
    border-bottom: 1px solid var(--color-dark-border);
  }
  .terminal__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-dark-border);
  }
  .terminal__dot:nth-child(1) {
    background: #ff5f57;
  }
  .terminal__dot:nth-child(2) {
    background: #febc2e;
  }
  .terminal__dot:nth-child(3) {
    background: #28c840;
  }
  .terminal__title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-dark-text-dim);
  }
  .terminal__body {
    margin: 0;
    padding: var(--s-4) var(--s-5);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-dark-text-muted);
    overflow-x: auto;
  }
  .terminal__prompt {
    color: var(--color-accent);
    font-weight: 600;
    margin-right: 6px;
  }
  .terminal__out {
    color: var(--color-dark-text);
  }

  .hero__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--r-md);
    font-size: 15px;
    font-weight: 500;
    transition: transform var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out);
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .btn--primary:hover {
    background: var(--color-accent-dark);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .btn--ghost:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-pale);
  }

  @media (max-width: 600px) {
    .hero { padding: var(--s-10) 0 var(--s-8); }
    .terminal__body { font-size: 12px; }
  }
</style>
