---
import { ArrowUpRight } from '@lucide/astro';
---

<section class="hero" id="hero">
  <div class="container-narrow hero__inner">
    <p class="hero__name"><span>lazy</span><span class="hero__note">个人主页 / 持续折腾中</span></p>
    <h1 class="hero__title">
      独立开发者，用 AI 造自己想要的工具。
    </h1>
    <p class="hero__lede">
      做过 Swift 编译器、LLVM 后端。现在做手机实验室、个人 Agent 和基础设施。
    </p>
    <div class="hero__ctas">
      <a href="/projects/" class="btn btn--primary">看项目</a>
      <a href="#posts" class="btn btn--ghost">读文章</a>
    </div>
    <a class="hero__outside" href="/about/">代码之外，滑雪、潜水、攀岩。<ArrowUpRight size={14} aria-hidden="true" /></a>
  </div>
</section>

<style>
  .hero {
    padding: var(--s-12) 0 var(--s-10);
  }

  .hero__inner {
    max-width: var(--max-w-home);
  }

  .hero__name {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    margin: 0 0 var(--s-4);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero__title {
    margin: 0 0 var(--s-5);
    font-size: clamp(28px, 3.6vw, 42px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  .hero__lede {
    margin: 0 0 var(--s-6);
    max-width: 52ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .hero__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .hero__name > span:first-child { color: var(--color-accent); }
  .hero__note {
    padding-left: var(--s-4);
    border-left: 1px solid var(--color-border-strong);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--color-text-dim);
    font-weight: 400;
  }
  .hero__outside {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    margin-top: var(--s-5);
    color: var(--color-text-dim);
    font-size: 13px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--r-md);
    font-size: 15px;
    font-weight: 500;
    transition:
      transform var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out);
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .btn--primary:hover {
    background: var(--color-accent-dark);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .btn--ghost:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-pale);
  }

  @media (max-width: 600px) {
    .hero {
      padding: var(--s-8) 0 var(--s-6);
    }
    .hero__title br {
      display: none;
    }
  }
</style>
