---
---

<section class="hero" id="hero">
  <div class="container container-narrow hero__inner">
    <p class="hero__eyebrow eyebrow reveal">lazy · weichao.ren</p>
    <h1 class="hero__title">
      <span class="hero__typed" data-typewriter></span><span class="hero__cursor" aria-hidden="true">|</span>
    </h1>
    <p class="hero__sub" data-hero-sub>
      前宇宙大厂基础架构工程师 · 持滑雪 / 攀岩 / 游泳教练证 · 用 AI 造自己想要的工具
    </p>

    <!-- Terminal-style code block — visual focal point -->
    <div class="hero__terminal" data-hero-terminal>
      <div class="terminal__bar">
        <span class="terminal__dot"></span>
        <span class="terminal__dot"></span>
        <span class="terminal__dot"></span>
        <span class="terminal__title">whoami.sh</span>
      </div>
      <pre class="terminal__body"><code><span class="terminal__prompt">$</span> whoami
<span class="terminal__out">ex-big-tech / indie-dev</span>

<span class="terminal__prompt">$</span> ls skills/
<span class="terminal__out">swift/  llvm/  typescript/  ai/</span>

<span class="terminal__prompt">$</span> cat status.txt
<span class="terminal__out">building tools with AI</span>
<span class="terminal__out">skiing · climbing · diving</span></code></pre>
    </div>

    <div class="hero__ctas" data-hero-ctas>
      <a href="#posts" class="btn btn--primary">读文章</a>
      <a href="/projects/" class="btn btn--ghost">看项目</a>
      <a href="/about/" class="btn btn--ghost">关于我</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--s-16) 0 var(--s-12);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    max-width: 680px;
  }

  .hero__eyebrow {
    color: var(--color-text-dim);
    margin-bottom: var(--s-5);
  }

  .hero__title {
    font-size: clamp(20px, 2.8vw, 28px);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    margin: 0 0 var(--s-4);
    color: var(--color-text);
    min-height: 2.8em;
  }

  .hero__cursor {
    color: var(--color-accent);
    font-weight: 300;
    animation: blink 1s step-end infinite;
  }

  .hero__sub {
    color: var(--color-text-muted);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 var(--s-6);
    opacity: 0;
  }
  .hero__sub.is-shown {
    animation: fade-in-up 600ms var(--ease-out) forwards;
  }

  /* Terminal code block */
  .hero__terminal {
    background: var(--color-dark-bg);
    border-radius: var(--r-lg);
    overflow: hidden;
    margin-bottom: var(--s-6);
    opacity: 0;
    border: 1px solid var(--color-dark-border);
  }
  .hero__terminal.is-shown {
    animation: fade-in-up 600ms var(--ease-out) forwards;
  }
  .terminal__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--color-dark-bg-soft);
    border-bottom: 1px solid var(--color-dark-border);
  }
  .terminal__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--color-dark-border);
  }
  .terminal__dot:nth-child(1) {
    background: #ff5f57;
  }
  .terminal__dot:nth-child(2) {
    background: #febc2e;
  }
  .terminal__dot:nth-child(3) {
    background: #28c840;
  }
  .terminal__title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-dark-text-dim);
  }
  .terminal__body {
    margin: 0;
    padding: var(--s-4) var(--s-5);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-dark-text-muted);
    overflow-x: auto;
  }
  .terminal__prompt {
    color: var(--color-accent);
    font-weight: 600;
    margin-right: 6px;
  }
  .terminal__out {
    color: var(--color-dark-text);
  }

  .hero__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    opacity: 0;
  }
  .hero__ctas.is-shown {
    animation: fade-in-up 600ms var(--ease-out) forwards;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--r-md);
    font-size: 15px;
    font-weight: 500;
    transition: transform var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out);
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
  .btn--primary:hover {
    background: var(--color-accent-dark);
  }
  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .btn--ghost:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-pale);
  }

  @media (max-width: 600px) {
    .hero { padding: var(--s-10) 0 var(--s-8); }
    .terminal__body { font-size: 12px; }
  }
</style>

<script>
  const typed = document.querySelector<HTMLElement>('[data-typewriter]');
  const sub = document.querySelector<HTMLElement>('[data-hero-sub]');
  const terminal = document.querySelector<HTMLElement>('[data-hero-terminal]');
  const ctas = document.querySelector<HTMLElement>('[data-hero-ctas]');

  if (typed) {
    const TEXT = 'Ex-big-tech infra engineer, now an indie dev with ski/climbing/swim instructor certs.';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced) {
      typed.textContent = TEXT;
      sub?.classList.add('is-shown');
      terminal?.classList.add('is-shown');
      ctas?.classList.add('is-shown');
    } else {
      let i = 0;
      const tick = () => {
        if (i < TEXT.length) {
          typed.textContent += TEXT[i];
          i++;
          setTimeout(tick, 32 + Math.random() * 28);
        } else {
          sub?.classList.add('is-shown');
          setTimeout(() => terminal?.classList.add('is-shown'), 200);
          setTimeout(() => ctas?.classList.add('is-shown'), 400);
        }
      };
      setTimeout(tick, 400);
    }
  }
</script>
