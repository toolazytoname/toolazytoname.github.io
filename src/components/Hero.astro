---
---

<section class="hero" id="hero">
  <div class="container container-narrow hero__inner">
    <p class="hero__eyebrow eyebrow reveal">lazy · weichao.ren</p>
    <div class="hero__ctas reveal">
      <a href="#posts" class="btn btn--primary">读文章</a>
      <a href="/about" class="btn btn--ghost">关于我</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--s-16) 0 var(--s-12);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__inner {
    max-width: 680px;
  }

  .hero__eyebrow {
    color: var(--color-text-dim);
    margin-bottom: var(--s-5);
  }

  .hero__ctas {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--r-md);
    font-size: 15px;
    font-weight: 500;
    transition: transform var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out),
      border-color var(--t-fast) var(--ease-out);
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn--primary {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .btn--primary:hover {
    background: var(--color-ink-soft);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .btn--ghost:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-subtle);
  }

  @media (max-width: 600px) {
    .hero {
      padding: var(--s-10) 0 var(--s-8);
    }
  }
</style>
