---
import { getCollection } from 'astro:content';
import { postSlug } from '@lib/permalink';

interface Props {
  limit?: number;
}

const { limit = 5 } = Astro.props;

const allPosts = await getCollection('posts');
const sorted = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = sorted.slice(0, limit);

const totalCount = allPosts.length;
---

<section class="post-feed" id="posts">
  <div class="container container-narrow">
    <header class="post-feed__head reveal">
      <p class="eyebrow">Blog · 博客</p>
      <h2 class="post-feed__title">最新文章</h2>
    </header>

    <ol class="post-feed__list">
      {latest.map((post) => {
        const slug = postSlug(post.id, post.data);
        const summary =
          post.data.summary ??
          post.body?.split('\n').find((l) => l.trim().length > 0)?.slice(0, 120) ??
          '';
        const dateStr = post.data.date.toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        });

        return (
          <li class="post-feed__item reveal">
            <a href={`/${slug}`} class="post-feed__link">
              <time class="post-feed__date" datetime={post.data.date.toISOString()}>
                {dateStr}
              </time>
              <h3 class="post-feed__item-title">{post.data.title}</h3>
              {summary && <p class="post-feed__summary">{summary}</p>}
            </a>
          </li>
        );
      })}
    </ol>

    <div class="post-feed__more reveal">
      <a href="/posts" class="post-feed__more-link">
        查看全部 {totalCount} 篇 →
      </a>
    </div>
  </div>
</section>

<style>
  .post-feed {
    padding: var(--s-24) 0;
  }

  .post-feed__head {
    margin-bottom: var(--s-10);
  }

  .post-feed__title {
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 500;
    line-height: 1.15;
    margin: var(--s-3) 0;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .post-feed__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .post-feed__item {
    border-top: 1px solid var(--color-border);
  }

  .post-feed__link {
    display: block;
    padding: var(--s-5) 0;
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out);
  }

  .post-feed__link:hover {
    text-decoration: none;
  }

  .post-feed__link:hover .post-feed__item-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-feed__date {
    display: block;
    font-size: 13px;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    margin-bottom: var(--s-1);
  }

  .post-feed__item-title {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 var(--s-1);
    color: var(--color-text);
  }

  .post-feed__summary {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-feed__more {
    margin-top: var(--s-8);
    text-align: center;
  }

  .post-feed__more-link {
    font-size: 15px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out);
  }

  .post-feed__more-link:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
