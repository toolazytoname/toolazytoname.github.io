---
import { getCollection } from 'astro:content';
import { postSlug } from '@lib/permalink';

interface Props {
  limit?: number;
}

const { limit = 5 } = Astro.props;

const allPosts = await getCollection('posts');
const sorted = allPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = sorted.slice(0, limit);

const totalCount = allPosts.length;
---

<section class="post-feed" id="posts">
  <div class="container container-narrow">
    <header class="post-feed__head reveal">
      <p class="eyebrow">Blog · 博客</p>
      <h2 class="post-feed__title">最新文章</h2>
    </header>

    <ol class="post-feed__list">
      {latest.map((post, i) => {
        const slug = postSlug(post.id, post.data);
        const summary =
          post.data.summary ??
          post.body?.split('\n').find((l) => l.trim().length > 0)?.slice(0, 120) ??
          '';
        const dateStr = post.data.date.toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        });
        const monthDay = `${String(post.data.date.getMonth() + 1).padStart(2, '0')}/${String(post.data.date.getDate()).padStart(2, '0')}`;

        return (
          <li class="post-feed__item reveal" style={`--i: ${i};`}>
            <a href={`/${slug}/`} class="post-feed__link">
              {post.data.cover ? (
                <img src={post.data.cover} alt="" class="post-feed__thumb post-feed__thumb--img" loading="lazy" />
              ) : (
                <div class="post-feed__thumb post-feed__thumb--fallback">
                  <span class="post-feed__thumb-date">{monthDay}</span>
                </div>
              )}
              <div class="post-feed__content">
                <time class="post-feed__date" datetime={post.data.date.toISOString()}>
                  {dateStr}
                </time>
                <h3 class="post-feed__item-title">{post.data.title}</h3>
                {summary && <p class="post-feed__summary">{summary}</p>}
              </div>
            </a>
          </li>
        );
      })}
    </ol>

    <div class="post-feed__more reveal">
      <a href="/posts/" class="post-feed__more-link">
        查看全部 {totalCount} 篇 →
      </a>
    </div>
  </div>
</section>

<style>
  .post-feed { padding: var(--s-24) 0; }
  .post-feed__head { margin-bottom: var(--s-10); }
  .post-feed__title {
    font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 500;
    line-height: 1.15;
    margin: var(--s-3) 0;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .post-feed__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .post-feed__link {
    display: flex;
    gap: var(--s-4);
    padding: var(--s-4);
    border-radius: var(--r-lg);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out),
      background var(--t-fast) var(--ease-out);
  }
  .post-feed__link:hover {
    background: var(--color-bg-subtle);
  }
  .post-feed__link:hover { text-decoration: none; }
  .post-feed__link:hover .post-feed__item-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Thumbnail */
  .post-feed__thumb {
    width: 80px;
    height: 80px;
    border-radius: var(--r-md);
    flex-shrink: 0;
    overflow: hidden;
  }
  .post-feed__thumb--img {
    object-fit: cover;
  }
  .post-feed__thumb--fallback {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-soft));
  }
  .post-feed__thumb-date {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-accent-contrast);
    letter-spacing: -0.02em;
  }

  .post-feed__content {
    flex: 1;
    min-width: 0;
  }
  .post-feed__date {
    display: block;
    font-size: 13px;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    margin-bottom: var(--s-1);
  }
  .post-feed__item-title {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 var(--s-1);
    color: var(--color-text);
  }
  .post-feed__summary {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-feed__more { margin-top: var(--s-8); text-align: center; }
  .post-feed__more-link {
    font-size: 15px;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--t-fast) var(--ease-out);
  }
  .post-feed__more-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 480px) {
    .post-feed__thumb { width: 60px; height: 60px; }
    .post-feed__thumb-date { font-size: 13px; }
  }
</style>
