---
import type { Work } from '@data/works';

interface Props {
  work: Work;
  index: number;
}

const { work, index } = Astro.props;
---

<article
  class="work-card reveal"
  data-status={work.status}
  style={`--i: ${index};`}
>
  <div class="work-card__inner">
    <header class="work-card__head">
      <span class="work-card__tag">{work.tag}</span>
      <span class={`work-card__status work-card__status--${work.status}`}>
        {work.status}
      </span>
    </header>
    <h3 class="work-card__title">{work.title}</h3>
    <p class="work-card__subtitle">{work.subtitle}</p>
    <p class="work-card__summary">{work.summary}</p>
    <ul class="work-card__highlights">
      {work.highlights.map((h) => (
        <li>{h}</li>
      ))}
    </ul>
    <div class="work-card__links">
      {work.links.map((l) => (
        <a href={l.url} class="work-card__link" rel="noopener" target="_blank">
          {l.label} →
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  .work-card__inner {
    border-radius: var(--r-xl);
    padding: var(--s-6);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
  }

  .work-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--s-5);
  }
  .work-card__tag {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .work-card__status {
    font-size: 10px;
    padding: 3px 8px;
    border-radius: 980px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .work-card__status--shipped {
    background: var(--color-ink);
    color: var(--color-bg);
  }
  .work-card__status--wip {
    background: var(--color-bg-subtle);
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
  }
  .work-card__status--archived {
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
  }

  .work-card__title {
    font-size: 26px;
    line-height: 1.15;
    margin: 0 0 var(--s-2);
    color: var(--color-text);
  }
  .work-card__subtitle {
    color: var(--color-text-muted);
    margin: 0 0 var(--s-4);
    font-size: 14px;
  }
  .work-card__summary {
    color: var(--color-text);
    font-size: 15px;
    line-height: 1.6;
    margin: 0 0 var(--s-4);
  }
  .work-card__highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-5);
  }
  .work-card__highlights li {
    color: var(--color-text);
    padding: var(--s-2) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: 14px;
    position: relative;
    padding-left: var(--s-4);
  }
  .work-card__highlights li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-ink);
  }
  .work-card__highlights li:last-child {
    border-bottom: none;
  }

  .work-card__links {
    display: flex;
    gap: var(--s-3);
  }
  .work-card__link {
    color: var(--color-ink);
    font-size: 13px;
  }
</style>
