const fillIcons = new Set(['github', 'mail', 'rss', 'external', 'bot', 'shield', 'phone', 'cpu', 'server', 'archive']);
const isFill = fillIcons.has(name);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
