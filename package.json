{
  "name": "weichao-ren",
  "type": "module",
  "version": "1.0.0",
  "description": "weichao.ren — personal site rebuilt on Astro 7 + Vercel",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "start": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro check && astro build",
    "preview": "node -e \"console.error('The Vercel adapter does not support astro preview. Use npm run dev or npx vercel dev.'); process.exit(1)\"",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:urls": "python3 scripts/test_verify_urls.py && python3 scripts/verify-urls.py",
    "ci": "npm test && npm run build && npm run verify:urls && npm run verify:site",
    "verify:site": "python3 -m unittest discover -s scripts -p \"test_*.py\" && python3 scripts/verify-site.py",
    "audit:deps": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
    "verify:guard": "node scripts/verify-model-guard.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "audit:links": "python3 scripts/audit-external-links.py",
    "eval:model": "vitest run --config scripts/model-eval.config.ts",
    "release:check": "npm run audit:deps && npm run ci",
    "dev:local": "node scripts/with-project-env.mjs dev",
    "eval:model:local": "node scripts/with-project-env.mjs eval:model"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.5",
    "@lucide/astro": "^1.42.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "~7.2.8",
    "openai": "^4.78.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satori": "^0.29.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "rehype-raw": "7.0.0",
    "typescript": "^5.7.0",
    "vite": "8.2.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "fast-uri": "3.1.8",
    "fast-xml-parser": "5.10.1",
    "path-to-regexp": "6.3.0",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "js-yaml": "^4.3.2",
    "yaml": "2.8.3"
  }
}
