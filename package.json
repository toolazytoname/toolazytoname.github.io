{
  "name": "weichao-ren",
  "type": "module",
  "version": "1.0.0",
  "description": "weichao.ren — personal site rebuilt on Astro 7 + Vercel",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "start": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro check && astro build",
    "preview": "node -e \"console.error('The Vercel adapter does not support astro preview. Use npm run dev or npx vercel dev.'); process.exit(1)\"",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:urls": "python3 scripts/test_verify_urls.py && python3 scripts/verify-urls.py",
    "ci": "npm test && npm run build && npm run verify:urls"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.5",
    "@lucide/astro": "^1.42.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.2.0",
    "openai": "^4.78.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satori": "^0.29.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "fast-xml-parser": "5.10.1",
    "path-to-regexp": "6.3.0",
    "sharp": "0.35.0",
    "svgo": "4.0.2",
    "yaml": "2.8.3"
  }
}
