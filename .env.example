# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Optional chat. Leave keys empty for limited site FAQs.
# Without CHAT_PROVIDER, OPENROUTER_API_KEY takes priority over AGNES_API_KEY.
# Set explicitly to openrouter, compatible, or agnes to pin a provider.
CHAT_PROVIDER=

# Hosted free models: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Ordered free-only candidates, maximum 3; all share a 12-second deadline.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,openrouter/free

# Self-hosted FreeLLMAPI or another OpenAI-compatible gateway.
# Requires CHAT_PROVIDER=compatible. This calls the chat API, not gateway management APIs.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Legacy provider, used only when selected or no OpenRouter key is configured.
AGNES_API_KEY=

# Optional: override the site URL used in sitemap + RSS
PUBLIC_SITE_URL=https://www.weichao.ren

# Explicit direct mode: use only the configured chat API. Redis is not required.
# Retains request validation, timeout, and per-process rate limiting, NOT shared budgets.
# shared: optional Redis atomic quotas; missing/broken Redis fails closed in this mode.
# Empty: shared in production/Vercel, local in development. Production forbids local.
CHAT_PROTECTION_MODE=direct
CHAT_REDIS_REST_URL=
CHAT_REDIS_REST_TOKEN=
# Production defaults to weichao-production, preview to weichao-preview.
# All production instances/providers MUST share one namespace. Do not rotate to reset budgets.
CHAT_GUARD_NAMESPACE=
CHAT_MODEL_IP_HOURLY=60
# Fixed 24-hour / 30-day windows anchored at first admitted request, NOT calendar periods.
# Counts attempted generations, not dollars or tokens; failed requests are not refunded.
CHAT_MODEL_DAILY=40
CHAT_MODEL_MONTHLY=1000
CHAT_MODEL_CONCURRENCY=3
