# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Optional chat. Leave keys empty for limited site FAQs.
# Without CHAT_PROVIDER, OPENROUTER_API_KEY takes priority over AGNES_API_KEY.
# Set explicitly to openrouter, compatible, or agnes to pin a provider.
CHAT_PROVIDER=

# Hosted free models: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Ordered free-only candidates, maximum 3; all share a 12-second deadline.
OPENROUTER_MODELS=google/gemma-4-31b-it:free,openrouter/free

# Self-hosted FreeLLMAPI or another OpenAI-compatible gateway.
# Requires CHAT_PROVIDER=compatible. Configure free-only routes at the gateway.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Legacy provider, used only when selected or no OpenRouter key is configured.
AGNES_API_KEY=

# Optional: override the site URL used in sitemap + RSS
PUBLIC_SITE_URL=https://www.weichao.ren
